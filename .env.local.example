# All settings are optional. The app builds and runs with this file absent or empty.
# Set them at runtime only; the build needs none of them.

# Optional folder with your texts, product name and footer. Leave blank for inhalte/.
# See docs/content.md.
KOMPASS_INHALTE_DIR=

# AI explanations, chat and the action catalogue. AI turns on when a provider key
# and AI_MODEL are set. With both keys and no AI_PROVIDER, Anthropic is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: anthropic or openai. Leave blank to pick the provider whose key is set.
AI_PROVIDER=
# Model ID at that provider. There is no built-in default. Example for Anthropic:
AI_MODEL=claude-sonnet-4-6
# Optional effort level, passed to the provider unchanged. Anthropic: low, medium,
# high, xhigh, max (model-dependent). OpenAI reasoning models: minimal, low, medium, high.
# Leave blank for the provider default.
AI_EFFORT=

# Member accounts (saving, comparing, admin area). Accounts turn on only when
# DATABASE_URL, BETTER_AUTH_SECRET and an email transport are set; in production
# BETTER_AUTH_URL and MAIL_FROM are required as well.
DATABASE_URL=
# At least 32 random characters, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL without trailing slash, for example https://kompass.example.org
BETTER_AUTH_URL=
MAILERSEND_API_KEY=
# Required in production: a sender address you verified in MailerSend.
MAIL_FROM=
# Optional sender name. Leave blank for the product name in betreiber.json.
MAIL_FROM_NAME=
# Comma-separated email addresses with access to /admin.
ADMIN_EMAILS=
# Development only: print sign-in codes to the server log instead of sending email.
# Ignored when NODE_ENV=production.
KONTO_MAIL_KONSOLE=

# Optional trusted proxy IP header. Leave blank for a shared anonymous limit.
# Set only if the proxy REPLACES it with one IP and the app port is not public.
# For example: x-real-ip.
# See docs/deployment.md#verify-the-trusted-header. Forwarded hosts never
# determine allowed origins.
TRUSTED_PROXY_IP_HEADER=
# AI budgets per process, per 15-minute window, and maximum active provider calls.
# These reset on restart; configure provider spend limits for a deployment-wide cap.
KI_GLOBAL_MAX_REQUESTS=1200
KI_MAX_PARALLEL=8
